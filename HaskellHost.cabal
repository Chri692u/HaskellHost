cabal-version:      2.4
name:               HaskellHost
version:            0.1.0.0
author:             Christoffer Lind Andersen
maintainer:         57995582+Chri692u@users.noreply.github.com
extra-source-files:
    CHANGELOG.md
    README.md

library
  hs-source-dirs:      src
  exposed-modules:     Console, Parser, Scripting, Secrets, Networking
                       
  build-depends:       base, mtl, text, containers, http-conduit,
                       parsec, haskeline, happstack-server, bytestring,
                       process

executable HaskellHost
    main-is:          Main.hs
    build-depends:    base, text, bytestring, containers, happstack-server, directory, filepath, HaskellHost
    hs-source-dirs:   app
    default-language: Haskell2010
